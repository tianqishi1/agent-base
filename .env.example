# ==== Model providers (OpenAI-compatible) ====
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

DASHSCOPE_API_KEY=sk-xxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.openai.com/v1

# Local models (Ollama / vLLM), no key needed:
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ==== Runtime (relative to the repo root; absolute paths also work) ====
# File tools are sandboxed to this directory:
AGENTBASE_WORKSPACE=./workspace
# Sessions / traces stored here:
AGENTBASE_DATA_DIR=./data
# Where agent YAML definitions live:
AGENTBASE_AGENTS_DIR=./agents
